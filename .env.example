# Caminho do arquivo DuckDB gerado (nao versionado)
DB_PATH=./biodiversidade.duckdb

# CSV com a lista de fontes IPT (taxa + ocorrencias)
IPT_SOURCES_CSV=./ipt_sources.csv

# Opcional: tamanho do lote de escrita (default 5000, maximo 10000)
BULK_BATCH_SIZE=5000

# Opcional: timeout de download HTTP em minutos (default 30)
HTTP_TIMEOUT_MIN=30

# Opcional: nivel/formato de log
LOG_LEVEL=info
LOG_FORMAT=text

# Opcional: diretorio de cache dos DwC-A baixados (default: cache do usuario)
# CACHE_DIR=C:\Users\USUARIO\AppData\Local\biodiversidade
